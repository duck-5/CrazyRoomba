# =============================================================================
# Roomba 960 Controller Environment Configuration
# Copy this file to .env to override default parameters: cp .env.example .env
# =============================================================================

# HTTP Web Server Port
ROOMBA_HTTP_PORT=8000
ROOMBA_HOST=0.0.0.0

# Initial Roomba Operating Mode (Safe or Full)
# Safe: Motor interlocks active (stops on bumper hit, wheel drop, or cliff)
# Full: Motor interlocks bypassed (useful for workbench testing with wheels elevated)
ROOMBA_MODE=Safe

# Serial Port & Baudrate
# If ROOMBA_PORT is left blank, the controller will automatically auto-discover the Roomba (VID 0x27A6)
# On Raspberry Pi: /dev/ttyACM0 or /dev/ttyUSB0
# On Windows: COM11
ROOMBA_PORT=
ROOMBA_BAUDRATE=115200

# Offline Simulation Mode (true or false)
# When set to true, simulates Roomba sensors, battery, and motors without hardware
ROOMBA_MOCK=false

# Real-Time Telemetry & Autonomy Loop Frequencies (Hz)
ROOMBA_TELEMETRY_RATE_HZ=7.0
ROOMBA_BEHAVIOR_RATE_HZ=10.0

# Dead-Man Switch Timeout in seconds (stops motors if driving pulses cease)
ROOMBA_DEADMAN_TIMEOUT=0.5

# Camera / Vision Subsystem
ROOMBA_CAMERA_ENABLED=false
ROOMBA_CAMERA_INDEX=0

# CLI Teleop default speed (mm/s)
ROOMBA_TELEOP_SPEED=150
