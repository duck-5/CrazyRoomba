[Unit]
Description=Roomba 960 Web Controller and Behavior Daemon (Native Python)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/roomba_controller
ExecStart=/usr/bin/python3 scripts/run_server.py --host 0.0.0.0 --port 8000 --mode safe --auto-connect
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=ROOMBA_MODE=Safe

# Permissions
SupplementaryGroups=dialout video

[Install]
WantedBy=multi-user.target
